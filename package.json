{
  "name": "katsumascore-front",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.22.1",
    "npm": "11.11.0"
  },
  "scripts": {
    "generate:breakpoints": "node scripts/generate-breakpoints.mjs",
    "generate:genres": "node --import tsx scripts/generate-genres.mjs",
    "predev": "npm run generate:breakpoints && npm run generate:genres",
    "prebuild": "npm run generate:breakpoints && npm run generate:genres -- --required",
    "prestorybook": "npm run generate:breakpoints && npm run generate:genres",
    "prebuild-storybook": "npm run generate:breakpoints && npm run generate:genres",
    "dev": "next dev",
    "build": "node scripts/build-ssg.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:wp-schema": "node --import tsx --test tests/unit/wp-post-schema.test.ts",
    "test:eslint-config": "node --test tests/unit/eslint-config.test.mjs",
    "lint": "eslint src .storybook eslint-rules eslint.config.mjs",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:ui": "node scripts/lint-ui.mjs",
    "wp:gen-types": "openapi-typescript openapi/wp.yaml -o src/libs/api/wordpress/generated/wp-schema.d.ts",
    "verify:wp-api": "bash scripts/verify-wp-api.sh",
    "verify:wp-section2": "tsx scripts/verify-wp-section2.ts",
    "verify:wp-section2:relax": "VERIFY_WP_SECTION2_RELAX_ACF=1 tsx scripts/verify-wp-section2.ts",
    "chromatic": "chromatic",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "rm -rf storybook-static && storybook build -o storybook-static",
    "prepare": "husky",
    "test:ssg": "node --import tsx --test tests/unit/ssg-detail.test.ts tests/unit/ssg-cache.test.ts tests/unit/ssg-paths.test.ts tests/unit/ssg-scripts.test.ts tests/unit/ssg-pages.test.ts tests/unit/ssg-config.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.scss": "stylelint --fix"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "clsx": "^2.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "gsap": "^3.15.1",
    "htmlparser2": "^12.0.0",
    "next": "^16.4.5",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "^14.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "chromatic": "^18.14.1",
    "eslint": "^10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "sass": "^1.107.1",
    "storybook": "^10.3.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "glob@>=9 <14.0.2": "14.0.2",
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
