{
  "name": "katsumascore-front",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "25.8.1",
    "npm": "11.11.0"
  },
  "scripts": {
    "generate:breakpoints": "node scripts/generate-breakpoints.mjs",
    "generate:genres": "node scripts/generate-genres.mjs",
    "predev": "npm run generate:breakpoints && npm run generate:genres",
    "prebuild": "npm run generate:breakpoints && npm run generate:genres",
    "prestorybook": "npm run generate:breakpoints && npm run generate:genres",
    "prebuild-storybook": "npm run generate:breakpoints && npm run generate:genres",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src .storybook eslint-rules eslint.config.mjs",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:ui": "node scripts/lint-ui.mjs",
    "wp:gen-types": "openapi-typescript openapi/wp.yaml -o src/libs/api/wordpress/generated/wp-schema.d.ts",
    "verify:wp-api": "bash scripts/verify-wp-api.sh",
    "verify:wp-section2": "tsx scripts/verify-wp-section2.ts",
    "verify:wp-section2:relax": "VERIFY_WP_SECTION2_RELAX_ACF=1 tsx scripts/verify-wp-section2.ts",
    "chromatic": "chromatic",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "rm -rf storybook-static && storybook build -o storybook-static",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.scss": "stylelint --fix"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "clsx": "^2.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "gsap": "^3.15.0",
    "htmlparser2": "^12.0.0",
    "next": "^16.2.10",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swiper": "^14.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-links": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.6",
    "chromatic": "^18.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-storybook": "10.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "sass": "^1.102.0",
    "storybook": "^10.3.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "typescript": "^6"
  }
}
