# WordPress REST base (required for API). No trailing slash.
# Production example: https://katsumascore.blog/wp-json/wp/v2
# See docs/features/wordpress_production_api_verification.md
WP_API_URL=http://localhost:8080/wp-json/wp/v2

# Public WordPress site URL (images, links)
NEXT_PUBLIC_WP_BASE_URL=http://localhost:8080

# Canonical site URL for this Next app (OG, sitemap, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=KatsumaScore

# --- Optional (defaults match production slugs where noted) ---
# Parent page ID for seasonal reviews (pages + server-sitemap)
# WP_SEASONAL_REVIEW_PARENT_ID=

# Fixed page slug for /top (default: top)
# WP_TOP_PAGE_SLUG=top

# Category slug for /featured (default: featured)
# WP_FEATURED_CATEGORY_SLUG=featured

# Numeric category ID for anime block on home; if unset, slug "anime" or name match is used
# WP_ANIME_CATEGORY_ID=

# Movie category slug (default: movie)
# WP_MOVIE_CATEGORY_SLUG=movie

# Drama category slug (default: drama)
# WP_DRAMA_CATEGORY_SLUG=drama

# Custom taxonomy `genre` の REST コレクション名（WP の rest_base。既定: genre）
# WP_GENRE_REST_PATH=genre

# --- ISR webhook（POST /api/revalidate）---
# 未設定のとき API は 503。Bearer / X-Revalidate-Secret / ?secret= で照合する。
# REVALIDATE_SECRET=

# --- 公開スクリプト・埋め込み（任意）---
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_ADSENSE_ID=
# Facebook Page Plugin の iframe src（ホーム埋め込み用）
# NEXT_PUBLIC_FACEBOOK_TIMELINE_EMBED_URL=
